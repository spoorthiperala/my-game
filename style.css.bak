/*
 * Pink Planet: Tech Crush - Premium Cyber-Pink Aesthetic System
 */

@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800;900&family=Outfit:wght@400;600;700;800&display=swap');

:root {
  --bg-dark: #0a0314;
  --bg-card: rgba(255, 42, 133, 0.07);
  --border-neon: rgba(255, 42, 133, 0.4);
  --pink-primary: #ff2a85;
  --pink-glow: rgba(255, 42, 133, 0.6);
  --cyan-accent: #00f0ff;
  --cyan-glow: rgba(0, 240, 255, 0.6);
  --purple-accent: #bd00ff;
  --green-accent: #00ff9d;
  --gold-accent: #ffea00;
  --glass-bg: rgba(20, 10, 35, 0.65);
  --font-title: 'Orbitron', sans-serif;
  --font-body: 'Outfit', sans-serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}

body {
  background-color: var(--bg-dark);
  background-image: 
    radial-gradient(circle at 15% 20%, rgba(255, 42, 133, 0.18) 0%, transparent 45%),
    radial-gradient(circle at 85% 80%, rgba(0, 240, 255, 0.15) 0%, transparent 45%),
    radial-gradient(circle at 50% 50%, rgba(189, 0, 255, 0.12) 0%, transparent 60%);
  color: #ffffff;
  font-family: var(--font-body);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow-x: hidden;
}

/* Background animated Cyber Grid */
body::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: 
    linear-gradient(rgba(255, 42, 133, 0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 42, 133, 0.04) 1px, transparent 1px);
  background-size: 40px 40px;
  pointer-events: none;
  z-index: 0;
}

#app-container {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 600px;
  padding: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
}

/* Header & Top Bar */
header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 16px;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--border-neon);
  border-radius: 18px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), 0 0 15px var(--pink-glow);
  margin-bottom: 12px;
}

.logo-group {
  display: flex;
  align-items: center;
  gap: 10px;
}

.logo-icon {
  font-size: 28px;
  filter: drop-shadow(0 0 8px var(--pink-primary));
  animation: floatMascot 3s ease-in-out infinite;
}

.logo-text h1 {
  font-family: var(--font-title);
  font-size: 1.1rem;
  background: linear-gradient(135deg, #ffffff 0%, var(--pink-primary) 50%, var(--cyan-accent) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  letter-spacing: 1px;
}

.logo-text p {
  font-size: 0.75rem;
  color: var(--cyan-accent);
  letter-spacing: 0.5px;
}

.header-controls {
  display: flex;
  gap: 8px;
}

.icon-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #fff;
  border-radius: 12px;
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.icon-btn:hover, .icon-btn:active {
  background: var(--pink-primary);
  border-color: var(--pink-primary);
  box-shadow: 0 0 12px var(--pink-glow);
  transform: scale(1.08);
}

/* Nav Tabs */
.nav-tabs {
  display: flex;
  width: 100%;
  gap: 8px;
  margin-bottom: 12px;
}

.tab-btn {
  flex: 1;
  padding: 10px 12px;
  border-radius: 14px;
  background: rgba(20, 10, 35, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #bbb;
  font-family: var(--font-title);
  font-size: 0.8rem;
  cursor: pointer;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.tab-btn.active {
  background: linear-gradient(135deg, var(--pink-primary), #bd00ff);
  color: #ffffff;
  border-color: #ff66b2;
  box-shadow: 0 0 15px var(--pink-glow);
  transform: translateY(-2px);
}

/* Screens */
.screen {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: opacity 0.3s ease;
}

.hidden {
  display: none !important;
}

.screen.hidden {
  display: none !important;
}

/* Level Selector Map Screen */
.map-container {
  width: 100%;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  border: 1px solid var(--border-neon);
  border-radius: 20px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
}

.map-title {
  font-family: var(--font-title);
  color: var(--cyan-accent);
  margin-bottom: 16px;
  font-size: 1.1rem;
  text-shadow: 0 0 10px var(--cyan-glow);
}

.levels-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  width: 100%;
}

.level-card {
  background: rgba(255, 42, 133, 0.08);
  border: 1px solid rgba(255, 42, 133, 0.3);
  border-radius: 16px;
  padding: 14px 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  position: relative;
}

.level-card:hover:not(.locked) {
  background: rgba(255, 42, 133, 0.25);
  border-color: var(--pink-primary);
  box-shadow: 0 0 20px var(--pink-glow);
  transform: translateY(-4px);
}

.level-card.locked {
  opacity: 0.4;
  cursor: not-allowed;
  filter: grayscale(0.8);
}

.level-num {
  font-family: var(--font-title);
  font-size: 1.4rem;
  color: #fff;
}

.level-world {
  font-size: 0.7rem;
  color: var(--cyan-accent);
  margin-top: 4px;
  text-align: center;
}

.level-stars {
  margin-top: 6px;
  font-size: 12px;
  color: var(--gold-accent);
}

/* PC Builder Workshop Screen */
.workshop-container {
  width: 100%;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  border: 1px solid var(--border-neon);
  border-radius: 20px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pc-preview-box {
  width: 100%;
  height: 180px;
  background: radial-gradient(circle at center, rgba(255, 42, 133, 0.2) 0%, rgba(10, 3, 20, 0.8) 100%);
  border: 2px solid var(--pink-primary);
  border-radius: 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
  box-shadow: 0 0 25px var(--pink-glow) inset;
  position: relative;
  overflow: hidden;
}

.pc-rig-graphic {
  font-size: 64px;
  filter: drop-shadow(0 0 15px var(--cyan-accent));
  animation: floatMascot 4s ease-in-out infinite;
}

.pc-parts-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 100%;
  max-height: 380px;
  overflow-y: auto;
  padding-right: 4px;
}

.part-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 14px;
  padding: 10px 14px;
}

.part-card.owned {
  border-color: var(--green-accent);
  background: rgba(0, 255, 157, 0.08);
}

.part-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.part-icon {
  font-size: 28px;
}

.part-details h4 {
  font-family: var(--font-title);
  font-size: 0.85rem;
  color: #fff;
}

.part-details p {
  font-size: 0.75rem;
  color: var(--cyan-accent);
}

.buy-btn {
  padding: 8px 14px;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--pink-primary), #bd00ff);
  border: none;
  color: #fff;
  font-family: var(--font-title);
  font-size: 0.75rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.buy-btn:hover {
  transform: scale(1.05);
  box-shadow: 0 0 12px var(--pink-glow);
}

.buy-btn:disabled {
  background: #444;
  cursor: not-allowed;
  opacity: 0.6;
}

/* Main Game Play Screen */
.game-info-panel {
  width: 100%;
  display: flex;
  justify-content: space-between;
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  border: 1px solid var(--border-neon);
  border-radius: 16px;
  padding: 10px 16px;
  margin-bottom: 10px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
}

.info-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.info-label {
  font-size: 0.7rem;
  color: #aaa;
  letter-spacing: 0.5px;
}

.info-value {
  font-family: var(--font-title);
  font-size: 1.2rem;
  color: var(--gold-accent);
  text-shadow: 0 0 8px rgba(255, 234, 0, 0.4);
}

/* Boss Bar */
.boss-bar-container {
  width: 100%;
  background: rgba(255, 0, 85, 0.15);
  border: 1px solid #ff0055;
  border-radius: 12px;
  padding: 8px 12px;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.boss-avatar {
  font-size: 32px;
  animation: floatMascot 2s ease-in-out infinite;
}

.boss-hp-wrapper {
  flex: 1;
}

.boss-name {
  font-family: var(--font-title);
  font-size: 0.8rem;
  color: #ff0055;
  display: flex;
  justify-content: space-between;
  margin-bottom: 4px;
}

.boss-hp-track {
  width: 100%;
  height: 12px;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 6px;
  overflow: hidden;
  border: 1px solid rgba(255, 0, 85, 0.5);
}

.boss-hp-fill {
  height: 100%;
  width: 100%;
  background: linear-gradient(90deg, #ff0055, #ff6600);
  transition: width 0.3s ease;
  box-shadow: 0 0 10px #ff0055;
}

.level-objectives-bar {
  width: 100%;
  background: rgba(0, 240, 255, 0.08);
  border: 1px solid rgba(0, 240, 255, 0.3);
  border-radius: 12px;
  padding: 8px 12px;
  font-size: 0.85rem;
  color: var(--cyan-accent);
  text-align: center;
  margin-bottom: 10px;
}

/* Game Board Wrapper & Canvas FX */
.board-wrapper {
  position: relative;
  width: 100%;
  max-width: 440px;
  aspect-ratio: 1 / 1;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  border: 2px solid var(--border-neon);
  border-radius: 20px;
  padding: 8px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6), 0 0 20px var(--pink-glow);
}

#game-board {
  width: 100%;
  height: 100%;
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  grid-template-rows: repeat(8, 1fr);
  gap: 6px;
}

#fx-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 10;
}

/* Component Tile Styles */
.tile {
  position: relative;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.05);
  border: 1.5px solid rgba(255, 255, 255, 0.15);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}

.tile:hover {
  transform: scale(1.06);
  border-color: var(--tile-color, var(--pink-primary));
  box-shadow: 0 0 12px var(--tile-color, var(--pink-glow));
}

.tile.selected {
  border-color: #ffffff;
  box-shadow: 0 0 16px #ffffff, 0 0 25px var(--pink-primary);
  animation: pulseSelect 0.8s ease-in-out infinite alternate;
}

.comp-icon {
  width: 75%;
  height: 75%;
  filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
}

.spin-fan {
  animation: fanSpin 4s linear infinite;
}

/* Special Items Badges & Glows */
.special-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--pink-primary);
  border: 1px solid #fff;
  font-size: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
  box-shadow: 0 0 8px var(--pink-glow);
}

.special-cpu_burst_h, .special-cpu_burst_v {
  border-color: var(--pink-primary) !important;
  box-shadow: 0 0 15px var(--pink-glow) inset;
  animation: laserPulse 1.2s ease-in-out infinite alternate;
}

.special-gpu_laser {
  border-color: var(--cyan-accent) !important;
  box-shadow: 0 0 15px var(--cyan-glow) inset;
  animation: rainbowBorder 2s linear infinite;
}

.special-fan_bomb {
  border-color: var(--gold-accent) !important;
  box-shadow: 0 0 15px rgba(255, 234, 0, 0.6) inset;
}

.virus-corrupted {
  background: rgba(255, 0, 68, 0.25) !important;
  border-color: #ff0044 !important;
  animation: glitchShake 1.5s infinite;
}

/* Floating Assistant Mascot */
.bot-mascot-box {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 42, 133, 0.3);
  border-radius: 16px;
  padding: 10px 14px;
  margin-top: 12px;
}

.bot-avatar {
  font-size: 32px;
  animation: floatMascot 3s ease-in-out infinite;
}

.bot-speech {
  font-size: 0.8rem;
  color: #ddd;
  line-height: 1.3;
}

/* Modal Popup Dialog */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(5, 2, 12, 0.85);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20px;
}

.modal-card {
  background: var(--glass-bg);
  border: 2px solid var(--border-neon);
  border-radius: 24px;
  padding: 24px;
  width: 100%;
  max-width: 380px;
  text-align: center;
  box-shadow: 0 0 40px var(--pink-glow);
  animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.modal-title {
  font-family: var(--font-title);
  font-size: 1.4rem;
  margin-bottom: 12px;
}

.btn {
  width: 100%;
  padding: 12px;
  border-radius: 14px;
  font-family: var(--font-title);
  font-size: 0.85rem;
  cursor: pointer;
  border: none;
  margin-top: 10px;
  transition: all 0.2s ease;
}

.btn-primary {
  background: linear-gradient(135deg, var(--pink-primary), #bd00ff);
  color: #fff;
  box-shadow: 0 0 15px var(--pink-glow);
}

.btn-primary:hover {
  transform: scale(1.03);
  box-shadow: 0 0 25px var(--pink-glow);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

/* Floating Combo Pop text */
.floating-combo-pop {
  position: fixed;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-family: var(--font-title);
  font-size: 1.8rem;
  font-weight: 900;
  pointer-events: none;
  z-index: 2000;
  animation: floatUpFade 1.2s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  text-shadow: 0 0 15px currentColor;
}

/* Animations */
@keyframes floatMascot {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
}

@keyframes fanSpin {
  100% { transform: rotate(360deg); }
}

@keyframes pulseSelect {
  0% { transform: scale(1); }
  100% { transform: scale(1.1); }
}

@keyframes laserPulse {
  0% { box-shadow: 0 0 8px var(--pink-glow) inset; }
  100% { box-shadow: 0 0 20px var(--pink-primary) inset; }
}

@keyframes rainbowBorder {
  0% { border-color: var(--pink-primary); }
  33% { border-color: var(--cyan-accent); }
  66% { border-color: var(--gold-accent); }
  100% { border-color: var(--pink-primary); }
}

@keyframes glitchShake {
  0%, 100% { transform: translate(0, 0); }
  20% { transform: translate(-2px, 2px); }
  40% { transform: translate(2px, -2px); }
  60% { transform: translate(-1px, -1px); }
  80% { transform: translate(1px, 1px); }
}

@keyframes popIn {
  0% { transform: scale(0.7); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes floatUpFade {
  0% { opacity: 0; transform: translate(-50%, -20%) scale(0.6); }
  20% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
  100% { opacity: 0; transform: translate(-50%, -100%) scale(1); }
}

.boss-attack-shake {
  animation: glitchShake 0.4s ease-in-out infinite;
}
